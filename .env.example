# Saaya environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored and never committed. Names and descriptions only here.

# --- Required ---

# Anthropic API key. Powers the main agent and the reflection writer.
# Named CLAUDE_API_KEY by project convention; server config maps it to the
# Anthropic client explicitly (langchain-anthropic defaults to ANTHROPIC_API_KEY).
CLAUDE_API_KEY=

# --- Semantic memory embeddings (one of these) ---

# OpenAI key, used only for text-embedding-3-small in the pgvector store.
# Recommended: cheapest reliable path, no GPU or sidecar container.
OPENAI_API_KEY=

# --- Recommended for development ---

# LangSmith tracing. Free key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=saaya-dev

# --- Provided by docker-compose, no action needed for local dev ---

# Postgres connection for checkpoints, store, and application tables.
DATABASE_URL=postgresql://saaya:saaya@localhost:5433/saaya

# --- Later phases (leave empty for now) ---

# Slack channel (phase: communication channels)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
